{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AssetFlow",
  "version": "1.0.0",
  "identifier": "com.assetflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "AssetFlow",
        "width": 1440,
        "height": 940,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#101112",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; connect-src 'self' ipc: http://ipc.localhost blob: data:; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Your creative work, in order.",
    "category": "Productivity",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
